# ============================================================
# OutFast Backend AI — Variables de Entorno
# ============================================================
# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas el archivo .env al repositorio.
# ============================================================

# API Key del modelo de visión (Gemini o Claude)
AI_API_KEY=YOUR_API_KEY_HERE

# URL base de la API de visión
AI_API_URL=https://generativelanguage.googleapis.com/v1beta

# Modelo a utilizar para clasificación de prendas
AI_MODEL_NAME=gemini-3.0-flash

# Puerto del microservicio
PORT=8000
