# ===========================
# OutFast — .gitignore
# ===========================

# ---------- Java / Spring Boot ----------
backend-core/target/
backend-core/.mvn/wrapper/maven-wrapper.jar
*.class
*.jar
*.war
*.ear
*.log
hs_err_pid*

# ---------- Python / FastAPI ----------
backend-ai/__pycache__/
backend-ai/**/__pycache__/
backend-ai/*.pyc
backend-ai/.venv/
backend-ai/venv/
backend-ai/env/
backend-ai/*.egg-info/
backend-ai/dist/
backend-ai/build/

# ---------- Node / React ----------
frontend/node_modules/
frontend/dist/
frontend/.cache/
frontend/.vite/

# ---------- Environment variables ----------
.env
.env.local
.env.*.local
!.env.example
!**/.env.example

# ---------- IDE / Editors ----------
.idea/
*.iml
.vscode/
*.swp
*.swo
*~

# ---------- OS ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- Docker ----------
docker-compose.override.yml

# ---------- Misc ----------
*.bak
*.tmp
