# ============================================================
# OutFast Backend Core — Variables de Entorno
# ============================================================
# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas el archivo .env al repositorio.
# ============================================================

# Puerto del servidor Spring Boot
SERVER_PORT=8080

# Conexión a PostgreSQL (Supabase)
DATABASE_URL=jdbc:postgresql://YOUR_SUPABASE_HOST:5432/postgres
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_supabase_db_password

# Estrategia de JPA (update para dev, validate para prod)
JPA_DDL_AUTO=update

# URL del microservicio de IA (FastAPI)
AI_SERVICE_URL=http://localhost:8000
